# ─────────────────────────────────────────────────────────────────────────────
# Ground to Growth Connect — container deployment config
# Copy to `.env` (never commit it) and fill in real values.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED. 64-char hex (32 bytes). Generate with:  openssl rand -hex 32
# Encrypts all PII and coordinates at rest. If this ever changes, previously
# stored data can no longer be decrypted — set it once and back it up securely.
ENCRYPTION_KEY=

# Invite code required to register staff (volunteer/employee/admin) accounts.
STAFF_INVITE_CODE=g2g-staff

# Consent disclosure version shown/recorded with each consent.
CONSENT_VERSION=1.0

# Port the Go API listens on inside the container (usually leave as-is).
PORT=3001

# CORS: comma-separated list of allowed web origins, or "*" for any.
# The iOS app sends no Origin header and is always allowed.
CORS_ORIGIN=http://localhost:5173

# ── Document storage (Backblaze B2) ──────────────────────────────────────
# Required for production — without these, uploaded documents are stored
# encrypted inside the container's volume instead of Backblaze, which works
# but doesn't get you B2's durability/offsite backup. Get these from the
# Backblaze console after creating a bucket + an application key:
#   B2_ENDPOINT        the bucket's "Endpoint" field, e.g.
#                       https://s3.us-west-004.backblazeb2.com
#   B2_REGION           the region portion of that endpoint, e.g. us-west-004
#   B2_BUCKET           the bucket name
#   B2_KEY_ID           Application Keys → keyID
#   B2_APPLICATION_KEY  Application Keys → applicationKey (shown once, save it)
B2_ENDPOINT=
B2_REGION=
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=

# ── Push notifications to iPhones (optional) ────────────────────────────────
# Create a key in the Apple Developer site (Certificates, Identifiers &
# Profiles → Keys → + → Apple Push Notifications service). Download the .p8
# once, copy it to ./secrets/ on the VPS, and fill these in. Leave them blank
# and the app works the same, just without notifications.
#   APNS_KEY_PATH   where the key is inside the container, e.g. /secrets/AuthKey_ABC123DEFG.p8
#   APNS_KEY_ID     the 10-character Key ID shown next to the key
#   APNS_TEAM_ID    your Apple Developer Team ID
#   APNS_TOPIC      the app's bundle identifier
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=

# ── Host port publishing (the `api` service) ────────────────────────────────
# Interface to bind the API port on the host. Keep 127.0.0.1 when using Caddy
# or your own reverse proxy. Set 0.0.0.0 to expose the API directly (testing).
API_BIND=127.0.0.1
API_PORT=3001

# ── Automatic HTTPS (only used with:  docker compose --profile tls up -d) ────
# A domain/subdomain whose DNS A record already points at this VPS.
DOMAIN=api.example.org
# Email for Let's Encrypt expiry notices.
TLS_EMAIL=you@example.org
