# Local (non-container) development config. Copy to .env and fill in.
#   cp .env.example .env
# For containerized/VPS deployment, use the root-level .env instead.

# REQUIRED. 64-char hex (32 bytes). Generate with:  openssl rand -hex 32
ENCRYPTION_KEY=

# Path to the SQLite database file (defaults to backend/locvault.db if unset).
# SQLITE_PATH=./locvault.db

# Invite code required to register staff (volunteer/admin) accounts.
STAFF_INVITE_CODE=g2g-staff

# Consent disclosure version.
CONSENT_VERSION=1.0

# API port.
PORT=3001

# Allowed web origin(s), comma-separated, or "*".
CORS_ORIGIN=http://localhost:5173

# ── Document storage (Backblaze B2) ──────────────────────────────────────
# Optional. If any of these five are unset, documents are stored encrypted
# in a local directory instead (fine for local dev). Get these from the
# Backblaze console after creating a bucket + an application key:
#   B2_ENDPOINT        the bucket's "Endpoint" field, e.g.
#                       https://s3.us-west-004.backblazeb2.com
#   B2_REGION           the region portion of that endpoint, e.g. us-west-004
#   B2_BUCKET           the bucket name
#   B2_KEY_ID           Application Keys → keyID
#   B2_APPLICATION_KEY  Application Keys → applicationKey (shown once, save it)
# B2_ENDPOINT=
# B2_REGION=
# B2_BUCKET=
# B2_KEY_ID=
# B2_APPLICATION_KEY=

# Local-dev fallback only, used when B2_* above is unset. Defaults to a
# "documents" folder next to the SQLite database if left blank.
# DOCUMENTS_LOCAL_PATH=
