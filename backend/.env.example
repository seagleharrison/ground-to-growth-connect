# Local (non-container) development config. Copy to .env and fill in.
#   cp .env.example .env
# For containerized/VPS deployment, use the root-level .env instead.

# REQUIRED. 64-char hex (32 bytes). Generate with:  openssl rand -hex 32
ENCRYPTION_KEY=

# Path to the SQLite database file (defaults to backend/locvault.db if unset).
# SQLITE_PATH=./locvault.db

# Invite code required to register staff (volunteer/employee/admin) accounts.
STAFF_INVITE_CODE=g2g-staff

# Consent disclosure version.
CONSENT_VERSION=1.0

# API port.
PORT=3001

# Allowed web origin(s), comma-separated, or "*".
CORS_ORIGIN=http://localhost:5173
